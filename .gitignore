# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright (tests/README.md)
/test-results/
/playwright-report/
/blob-report/

# Backups and exports of the Sanity dataset, and anything encrypted
# (docs/backup-and-restore.md, docs/security/key-register.md). The
# repository is public: these hold private records and must never be in it.
*.tar.gz
*.tar.gz.enc
*.enc
*.ndjson
/backups/
/house-of-singh-backups/
*-export/
*-export.json
*-backup*.json

# Personal Claude Code settings (may hold local permissions or paths)
.claude/settings.local.json
