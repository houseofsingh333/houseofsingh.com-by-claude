# Copy this file to .env.local and fill in your values.
# These are also needed as environment variables in Vercel.

# Sanity project ID (from sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id

# Sanity dataset (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token — only needed for mutations (contact form)
# Create at sanity.io/manage → API → Tokens → Add token (Editor role)
# SANITY_API_TOKEN=your-token-here
